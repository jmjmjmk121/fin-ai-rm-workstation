# Copy to .env.local and replace placeholders locally. Never commit real values.
MUTUAL_FUND_DATA_MODE=fixture
SETSMART_LISTED_DATA_MODE=fixture
SETSMART_API_KEY=replace_with_newly_rotated_key
SETSMART_TIMEOUT_MS=8000
SETSMART_CACHE_TTL_MS=900000
SETSMART_STALE_FALLBACK_MS=86400000
SETSMART_MAX_RETRIES=2
SETSMART_RETRY_BASE_MS=250
SETSMART_FAILURE_BACKOFF_MS=60000
SETSMART_STALE_AFTER_DAYS=10

# SETSMART_LISTED_DATA_MODE=live uses only the official Listed-company EOD API contract.
# Live open-end mutual-fund mode still requires the separate API Reference after SETSMART login.
